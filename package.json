{
  "name": "lightbox2",
  "version": "3.0.5",
  "contributors": [
    {
      "name": "Lokesh Dhakar",
      "email": "lokesh.dhakar@gmail.com"
    },
    {
      "name": "Michael Hughes",
      "email": "work@mihughes.com"
    }
  ],
  "description": "The original Lightbox script. Uses jQuery.",
  "keywords": [
    "lightbox",
    "lightbox2",
    "overlay",
    "gallery",
    "slideshow",
    "images"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/msh9/lightbox2"
  },
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/msh9/lightbox2/blob/main/LICENSE"
    }
  ],
  "scripts": {
    "build": "npx concurrently \"npm:build:*\"",
    "build:js": "npx rollup -c rollup.config.mjs",
    "build:img": "cp src/images/* dist/images/",
    "build:css": "postcss src/css/lightbox.css -o dist/css/lightbox.min.css --no-map",
    "watch": "npx concurrently \"npm:watch:*\"",
    "watch:js": "npx rollup -c rollup.config.mjs -w",
    "watch:css": "postcss src/css/lightbox.css -o dist/css/lightbox.min.css --no-map --watch",
    "start": "http-server .",
    "lint": "npx concurrently \"npm:lint:*\"",
    "lint:js": "eslint",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "concurrently": "^10.0.6",
    "cssnano": "^8.0.10",
    "eslint": "^10.12.0",
    "eslint-plugin-jest": "^29.0.1",
    "exifreader": "^4.50.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.1.2",
    "jquery": "^3.7.1",
    "postcss": "^8.5.29",
    "postcss-cli": "^12.0.0",
    "prettier": "^3.3.2",
    "rollup": "^4.18.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-prettier": "^5.0.3"
  }
}
